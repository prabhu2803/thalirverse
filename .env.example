# =======================================================
# THALIRVERSE ENVIRONMENT VARIABLES CONFIGURATION
# =======================================================

# Copy this file as .env.local to link your local workspace to your real Supabase instance.
# Example: cp .env.example .env.local

# 1. Supabase Project Credentials
# Found in: Supabase Dashboard ➔ Project Settings ➔ API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anonymous-anon-key-here

# Service role key — server-side only, NEVER prefix with NEXT_PUBLIC_ or
# expose to the browser. Required for admin bulk student onboarding
# (creates auth accounts without hijacking the admin's own session).
# Found in: Supabase Dashboard ➔ Project Settings ➔ API ➔ service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 2. Local Environment Port (Optional)
# PORT=3000
